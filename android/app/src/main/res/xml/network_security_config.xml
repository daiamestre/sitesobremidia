<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     SOBRE MÍDIA PLAYER (LEGACY/CAPACITOR) — NETWORK SECURITY
     [SECURITY HARDENING P0]: HTTPS ONLY.
     - Cleartext (HTTP) NEGADO globalmente.
     - Somente certificados do sistema (sem user certs / MITM).
     ============================================================ -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>