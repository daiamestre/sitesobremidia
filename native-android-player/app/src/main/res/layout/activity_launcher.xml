<?xml version="1.0" encoding="utf-8"?>
<!--
    F-209: launcher Sobre Mídia (tela inicial do aparelho).
    Topo: logo (da empresa logada) + selo "Oficial" (é o botão da launcher original) · temperatura · Wi-Fi · hora e data.
    Meio: Destaques Sobre Mídia grande e centralizado, sem moldura — só as 4 telas (2 TVs 16:9 e 2 totens 9:16).
    Base, centralizados: Player e Menu (Menu abre aplicativos, loja de apps e Ajustes).
    Fundo: o padrão Sobre Mídia, a cor escolhida no painel ou a imagem de capa. O quadro gira junto com a tela (totem).
    F-212: TV em pé (retrato 9:16) — LauncherActivity.organizar() arruma esta mesma tela como celular: Destaques em
    coluna (TV 1, TV 2 embaixo dela, os 2 totens 9:16 lado a lado no fim), botões e Menu na largura da tela em pé.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_fundo">

    <FrameLayout
        android:id="@+id/launcher_quadro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/launcher_tela_fundo">

        <!-- capa escolhida no painel (some quando não há) + véu para o texto continuar legível -->
        <ImageView
            android:id="@+id/launcher_capa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/launcher_capa_veu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/launcher_capa_veu"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/launcher_coluna"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="22dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">

            <!-- topo -->
            <LinearLayout
                android:id="@+id/launcher_topo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- F-211: só a logo, sem sombra nem fumaça (pedido do dono) -->
                <FrameLayout
                    android:id="@+id/launcher_logo_caixa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/launcher_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="70dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Sobre Mídia"
                        android:maxWidth="340dp"
                        android:src="@drawable/logo" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- F-210: pendrive plugado (abre o explorador de arquivos) -->
                <TextView
                    android:id="@+id/launcher_usb"
                    style="@style/LauncherSelo"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/launcher_pilula"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_launcher_usb"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Pendrive"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launcher_btn_padrao"
                    style="@style/LauncherPilula"
                    android:layout_marginEnd="12dp"
                    android:text="★  Tela inicial"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launcher_clima"
                    style="@style/LauncherSelo"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launcher_rede"
                    style="@style/LauncherSelo"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/launcher_pilula"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_launcher_wifi"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/launcher_hora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:textColor="@color/sm_texto"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:id="@+id/launcher_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="dd/MM/yyyy"
                        android:format24Hour="dd/MM/yyyy"
                        android:textColor="@color/sm_texto_suave"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- meio: Destaques Sobre Mídia — só as 4 telas, grandes e centralizadas -->
            <FrameLayout
                android:id="@+id/launcher_destaque"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1">

                <com.antigravity.player.launcher.VitrineLayout
                    android:id="@+id/launcher_vitrine"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- base: selo "App Oficial" no canto inferior esquerdo; Player e Menu centralizados -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

            <!-- selo "App Oficial": por fora é o selo de verificado; por dentro, o botão da launcher original -->
            <LinearLayout
                android:id="@+id/launcher_btn_original"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:background="@drawable/launcher_selo_oficial"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_verificado" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.06"
                    android:shadowColor="#9900D4FF"
                    android:shadowRadius="10"
                    android:text="App Oficial"
                    android:textColor="#FFE0FAFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/launcher_botoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/launcher_cartao_player"
                    style="@style/LauncherBotaoBase"
                    android:background="@drawable/launcher_botao_principal">

                    <!-- o ícone do app Sobre Mídia (ou a logo da empresa logada) -->
                    <ImageView
                        android:id="@+id/launcher_icone_app"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Sobre Mídia Player"
                        android:src="@mipmap/ic_launcher_round" />

                    <LinearLayout style="@style/LauncherBotaoTextos">

                        <TextView
                            style="@style/LauncherBotaoTitulo"
                            android:text="Sobre Mídia Player" />

                        <TextView
                            android:id="@+id/launcher_contagem"
                            style="@style/LauncherBotaoSub" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/launcher_card_apps"
                    style="@style/LauncherBotaoBase"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/launcher_botao_principal"
                    android:gravity="center"
                    android:paddingStart="24dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_apps" />

                    <!-- F-211: ícone + "Menu" centralizados no cartão -->
                    <LinearLayout
                        style="@style/LauncherBotaoTextos"
                        android:layout_width="wrap_content"
                        android:layout_weight="0">

                        <!-- só o nome "Menu" (pedido do dono) -->
                        <TextView
                            style="@style/LauncherBotaoTitulo"
                            android:text="Menu" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Menu (abre pelo botão "Menu"): loja de apps, Ajustes do aparelho e todos os aplicativos -->
        <LinearLayout
            android:id="@+id/launcher_gaveta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/launcher_gaveta"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingTop="28dp"
            android:paddingEnd="44dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launcher_apps" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Menu"
                    android:textColor="@color/sm_texto"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/launcher_gaveta_voltar"
                    style="@style/LauncherPilula"
                    android:drawableStart="@drawable/ic_launcher_voltar"
                    android:text="Voltar" />
            </LinearLayout>

            <!-- funções do aparelho -->
            <LinearLayout
                android:id="@+id/launcher_gaveta_funcoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/launcher_card_loja"
                    style="@style/LauncherOpcaoMenu"
                    android:background="@drawable/launcher_botao_menu">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_loja" />

                    <TextView
                        style="@style/LauncherOpcaoTexto"
                        android:text="Loja de apps" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/launcher_btn_ajustes"
                    style="@style/LauncherOpcaoMenu"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/launcher_botao_menu">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_ajustes" />

                    <TextView
                        style="@style/LauncherOpcaoTexto"
                        android:text="Ajustes" />
                </LinearLayout>

                <!-- F-210: instalador de APK e explorador de arquivos do aparelho (aparecem se existirem) -->
                <LinearLayout
                    android:id="@+id/launcher_menu_apk"
                    style="@style/LauncherOpcaoMenu"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/launcher_botao_menu"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_apk" />

                    <TextView
                        style="@style/LauncherOpcaoTexto"
                        android:text="Instalar APK" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/launcher_menu_arquivos"
                    style="@style/LauncherOpcaoMenu"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/launcher_botao_menu"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_arquivos" />

                    <TextView
                        style="@style/LauncherOpcaoTexto"
                        android:text="Arquivos" />
                </LinearLayout>

                <!-- F-212: como a TV está instalada (deitada ou em pé) — vale antes de o aparelho ter uma tela no painel -->
                <LinearLayout
                    android:id="@+id/launcher_menu_posicao"
                    style="@style/LauncherOpcaoMenu"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/launcher_botao_menu">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_posicao" />

                    <TextView
                        style="@style/LauncherOpcaoTexto"
                        android:text="Posição da tela" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/launcher_apps_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:textColor="@color/sm_texto_suave"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/launcher_apps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="6dp" />

            <TextView
                android:id="@+id/launcher_sem_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum outro aplicativo para mostrar."
                android:textColor="@color/sm_texto_suave"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
