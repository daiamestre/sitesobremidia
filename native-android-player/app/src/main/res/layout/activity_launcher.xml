<?xml version="1.0" encoding="utf-8"?>
<!--
    F-200: launcher Sobre Mídia (tela inicial do aparelho), visual futurista.
    Topo: logo do gestor (maior) · temperatura · Wi-Fi · hora e data.
    Meio: cartão de destaque (mídias escolhidas pelo dono/ADM) + 4 cartões: Player, Aplicativos, Loja de apps, Ajustes.
    O quadro gira junto com a rotação da tela do Player (totem).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_fundo">

    <FrameLayout
        android:id="@+id/launcher_quadro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/launcher_tela_fundo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingTop="26dp"
            android:paddingEnd="44dp"
            android:paddingBottom="26dp">

            <!-- topo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/launcher_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="84dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Sobre Mídia"
                    android:maxWidth="340dp"
                    android:src="@drawable/logo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/launcher_clima"
                    style="@style/LauncherSelo"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launcher_rede"
                    style="@style/LauncherSelo"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/launcher_pilula"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_launcher_wifi"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/launcher_hora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:shadowColor="#CC000000"
                        android:shadowRadius="8"
                        android:textColor="@color/sm_texto"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:id="@+id/launcher_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="dd/MM/yyyy"
                        android:format24Hour="dd/MM/yyyy"
                        android:textColor="@color/sm_texto_suave"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- meio: "Destaques Sobre Mídia" (2 TVs 16:9 + 2 totens 9:16) e os 4 cartões, um pouco menores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/launcher_destaque"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.55"
                    android:background="@drawable/launcher_destaque"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/launcher_pilula"
                        android:letterSpacing="0.12"
                        android:paddingStart="12dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="3dp"
                        android:text="SOBRE MÍDIA"
                        android:textColor="@color/sm_acento"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:shadowColor="#CC000000"
                        android:shadowRadius="8"
                        android:text="Destaques Sobre Mídia"
                        android:textColor="@color/sm_texto"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <com.antigravity.player.launcher.VitrineLayout
                        android:id="@+id/launcher_vitrine"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="168dp"
                        android:clipChildren="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/launcher_cartao_player"
                            style="@style/LauncherCartao"
                            android:background="@drawable/launcher_card_player">

                            <!-- o ícone do próprio app Sobre Mídia (o mesmo da launcher original e da Play Store) -->
                            <ImageView
                                android:id="@+id/launcher_icone_app"
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:contentDescription="Sobre Mídia Player"
                                android:src="@mipmap/ic_launcher_round" />

                            <TextView
                                style="@style/LauncherCartaoTitulo"
                                android:text="Player" />

                            <TextView
                                android:id="@+id/launcher_contagem"
                                style="@style/LauncherCartaoSub" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/launcher_card_apps"
                            style="@style/LauncherCartao"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/launcher_card_apps">

                            <ImageView
                                style="@style/LauncherCartaoIcone"
                                android:src="@drawable/ic_launcher_apps" />

                            <TextView
                                style="@style/LauncherCartaoTitulo"
                                android:text="Aplicativos" />

                            <TextView
                                android:id="@+id/launcher_apps_total"
                                style="@style/LauncherCartaoSub" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="168dp"
                        android:layout_marginTop="14dp"
                        android:clipChildren="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/launcher_card_loja"
                            style="@style/LauncherCartao"
                            android:background="@drawable/launcher_card_loja">

                            <ImageView
                                style="@style/LauncherCartaoIcone"
                                android:src="@drawable/ic_launcher_loja" />

                            <TextView
                                style="@style/LauncherCartaoTitulo"
                                android:text="Loja de apps" />

                            <TextView
                                style="@style/LauncherCartaoSub"
                                android:text="Play Store" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/launcher_btn_ajustes"
                            style="@style/LauncherCartao"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/launcher_card_ajustes">

                            <ImageView
                                style="@style/LauncherCartaoIcone"
                                android:src="@drawable/ic_launcher_ajustes" />

                            <TextView
                                style="@style/LauncherCartaoTitulo"
                                android:text="Ajustes" />

                            <TextView
                                style="@style/LauncherCartaoSub"
                                android:text="do aparelho" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- base: launcher original (sempre à mão) e "definir como tela inicial" quando ainda não é -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/launcher_btn_original"
                    style="@style/LauncherPilula"
                    android:drawableStart="@drawable/ic_launcher_voltar"
                    android:text="Launcher original" />

                <TextView
                    android:id="@+id/launcher_btn_padrao"
                    style="@style/LauncherPilula"
                    android:layout_marginStart="12dp"
                    android:text="★  Definir como tela inicial"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- painel de aplicativos (abre pelo cartão "Aplicativos") -->
        <LinearLayout
            android:id="@+id/launcher_gaveta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/launcher_gaveta"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingTop="30dp"
            android:paddingEnd="44dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launcher_apps" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Aplicativos"
                    android:textColor="@color/sm_texto"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/launcher_gaveta_voltar"
                    style="@style/LauncherPilula"
                    android:drawableStart="@drawable/ic_launcher_voltar"
                    android:text="Voltar" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/launcher_apps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="6dp" />

            <TextView
                android:id="@+id/launcher_sem_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum outro aplicativo para mostrar."
                android:textColor="@color/sm_texto_suave"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
