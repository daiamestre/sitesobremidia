<?xml version="1.0" encoding="utf-8"?>
<!-- F-209: botão Player (retângulo arredondado, cor primária do sistema); com foco ganha a borda ciano -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="315" android:startColor="#FF4F46E5" android:endColor="#FF7C3AED" />
            <stroke android:width="3dp" android:color="#FF22D3EE" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="315" android:startColor="#FF4F46E5" android:endColor="#FF7C3AED" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="315" android:startColor="#E64F46E5" android:endColor="#E67C3AED" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
