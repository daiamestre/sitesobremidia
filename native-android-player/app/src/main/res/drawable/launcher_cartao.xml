<?xml version="1.0" encoding="utf-8"?>
<!-- F-200: cartão da launcher; com foco (controle remoto) ganha a borda ciano do sistema -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/sm_cartao_foco" />
            <stroke android:width="3dp" android:color="@color/sm_acento" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/sm_cartao_foco" />
            <stroke android:width="2dp" android:color="@color/sm_brilho" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/sm_cartao" />
            <stroke android:width="1dp" android:color="@color/sm_borda" />
        </shape>
    </item>
</selector>
