<?xml version="1.0" encoding="utf-8"?>
<!-- F-211: selo "App Oficial" em neon futurista (borda neon com brilho); é o botão da launcher original -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <stroke android:width="6dp" android:color="#3300D4FF" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="#E6101A3F" />
                    <stroke android:width="2dp" android:color="#FF00D4FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <stroke android:width="5dp" android:color="#1F00D4FF" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="#CC0A1230" />
                    <stroke android:width="1.5dp" android:color="#CC00D4FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
