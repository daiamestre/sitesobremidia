<?xml version="1.0" encoding="utf-8"?>
<!-- F-200: botões pequenos (pílulas de vidro) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#E6312E81" />
            <stroke android:width="2dp" android:color="#FF22D3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#99101A3F" />
            <stroke android:width="1dp" android:color="#557C6CF6" />
        </shape>
    </item>
</selector>
