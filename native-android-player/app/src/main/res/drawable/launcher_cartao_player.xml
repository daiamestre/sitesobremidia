<?xml version="1.0" encoding="utf-8"?>
<!-- F-200: cartão principal (Player Sobre Mídia) — gradiente da cor primária do sistema -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="0" android:startColor="@color/sm_primaria" android:endColor="@color/sm_brilho" />
            <stroke android:width="3dp" android:color="@color/sm_acento" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="0" android:startColor="#E64F46E5" android:endColor="#E67C6CF6" />
            <stroke android:width="1dp" android:color="#807C6CF6" />
        </shape>
    </item>
</selector>
