# ======================================================================
# KEYSTORE PROPERTIES (LOCAL, GITIGNORED — NUNCA COMMITAR)
# ======================================================================
# Copie para keystore.properties e preencha com os dados do keystore de
# PRODUÇÃO. Sem este arquivo o build de release FALHA de propósito
# (proteção contra APK publicado com debug keystore).
#
# Gere o keystore com (recomendado: 25+ anos, RSA 4096):
#   keytool -genkeypair -v -keystore sobremidia-release.jks \
#     -alias sobremidia -keyalg RSA -keysize 4096 -validity 9125 \
#     -storetype JKS
#
# ARMAZENE O KEYSTORE FORA DO REPO (nunca commitado, mesmo cifrado).
# Perdê-lo = impossibilidade de atualizar o app instalado.
# ======================================================================

STORE_FILE=C:/caminho/absoluto/sobremidia-release.jks
STORE_PASSWORD=TROQUE_ISSO
KEY_ALIAS=sobremidia
KEY_PASSWORD=TROQUE_ISSO

# [SECURITY FASE F] Pin do certificado de assinatura do release APK
# (SHA-256 do certificado, 64 hex). Quando preenchido, o OTA do player
# SÓ instala APK cujo certificado bata com este pin (fail-closed).
# Obtê-lo com:
#   keytool -exportcert -keystore sobremidia-release.jks -alias sobremidia \
#     -rfc -storepass <senha> | openssl x509 -outform der | \
#     openssl dgst -sha256
# (resultado: 64 caracteres hex — cole aqui)
OTA_RELEASE_CERT_SHA256=